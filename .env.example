# Required — a project API key with GPT-Live access. Server-side only; never shipped to the browser.
OPENAI_API_KEY=sk-proj-...

# Optional
PORT=3000
HOST=127.0.0.1
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-6-luna
BACKEND_REASONING=low
LIVE_VOICE=marin
BUSINESS_TIMEZONE=Asia/Kolkata
MAX_SESSIONS=3
# Server checks the caller actually said "yes" (from the live transcript) before saving a booking.
REQUIRE_SPOKEN_CONFIRMATION=true
# Comma-separated, only needed if you serve the UI from a different origin
ALLOWED_ORIGINS=
